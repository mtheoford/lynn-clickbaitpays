{
  "name": "proneurs-personal-cbp-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:sites": "SITES_BUILD=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env staging --keep-vars",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env production --keep-vars",
    "test": "node --test tests/calculator-math.test.ts tests/site-config.test.ts tests/billing-lifecycle.test.ts tests/customer-auth.test.ts tests/checkout-reservation.test.ts",
    "test:rendered:sites": "npm run build:sites && node --import ./tests/register-cloudflare-workers.mjs --test tests/rendered-html.test.mjs",
    "test:calculator": "node --test tests/calculator-math.test.ts",
    "audit:security": "node scripts/security-audit.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .open-next --ignore-pattern cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.8",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.4",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@aws-sdk/credential-provider-sso": "3.973.9",
    "undici": "7.29.0"
  },
  "type": "module"
}
