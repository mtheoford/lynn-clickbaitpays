# Public application URLs (these are embedded during the Next.js build)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_TENANT_BASE_DOMAIN=cbp.localhost
# Hosted pilot only: omit TENANT_BASE_DOMAIN and set the single Sites hostname.
# NEXT_PUBLIC_PRIMARY_DOMAIN=lynn-clickbaitpays.theoford.chatgpt.site
NEXT_PUBLIC_SUPPORT_EMAIL=support@proneurs.org
ENABLE_APPROVED_INCOME_STRATEGY_CONTENT=false
APP_ENV=local

# Stripe subscription billing (use test-mode values during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Internal administration through Cloudflare Access
ADMIN_EMAILS=
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=ProNeurs <sites@proneurs.org>
